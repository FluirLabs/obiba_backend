{
  "name": "@obiba/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "mail": "tsc -p tsconfig.build.json && node dist/email/cli.js"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testTimeout": 180000,
    "transform": {
      "^.+\\.(ts|tsx|js|mjs)$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "esModuleInterop": true,
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true
          },
          "diagnostics": {
            "ignoreCodes": [
              151001
            ]
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/\\.pnpm/(?!(@noble\\+|@scure\\+|near-api-js@|jose@))"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "mjs",
      "json"
    ],
    "moduleNameMapper": {
      "^@obiba/(domain|db|near|intents)$": "<rootDir>/../../packages/$1/src"
    }
  },
  "dependencies": {
    "@google-cloud/kms": "^5.7.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@obiba/db": "workspace:*",
    "@obiba/domain": "workspace:*",
    "@obiba/intents": "workspace:*",
    "@obiba/near": "workspace:*",
    "@scure/base": "^1.2.6",
    "bullmq": "^5.81.5",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^10.5.0",
    "ioredis": "^5.11.1",
    "near-api-js": "7.3.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@obiba/api": "workspace:*",
    "@obiba/guardian": "workspace:*",
    "@obiba/indexer": "workspace:*",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "borsh": "2.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.14",
    "typescript": "5.9.3"
  }
}

{
  "name": "@obiba/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testTimeout": 180000,
    "transform": {
      "^.+\\.(ts|tsx|js|mjs)$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "esModuleInterop": true,
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true
          },
          "diagnostics": {
            "ignoreCodes": [
              151001
            ]
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/\\.pnpm/(?!(@noble\\+|@scure\\+|near-api-js@|jose@))"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "mjs",
      "json"
    ],
    "moduleNameMapper": {
      "^@obiba/(domain|db|near|intents)$": "<rootDir>/../../packages/$1/src"
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@obiba/db": "workspace:*",
    "@obiba/domain": "workspace:*",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@testcontainers/postgresql": "^11",
    "@types/jest": "^30",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/supertest": "^6",
    "jest": "^30",
    "supertest": "^7",
    "testcontainers": "^11",
    "ts-jest": "^29.4",
    "typescript": "5.9.3"
  }
}

{
  "name": "@obiba/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testTimeout": 180000,
    "transform": {
      "^.+\\.(ts|tsx|js|mjs)$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "esModuleInterop": true,
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true
          },
          "diagnostics": {
            "ignoreCodes": [
              151001
            ]
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/\\.pnpm/(?!(@noble\\+|@scure\\+|near-api-js@|jose@))"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "mjs",
      "json"
    ],
    "moduleNameMapper": {
      "^@obiba/(domain|db|near|intents)$": "<rootDir>/../../packages/$1/src"
    }
  },
  "dependencies": {
    "@escape.tech/graphql-armor": "^3.2.0",
    "@google-cloud/kms": "^5.7.0",
    "@graphql-yoga/nestjs": "^3.25.1",
    "@graphql-yoga/plugin-persisted-operations": "^3.24.4",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "^11.2.7",
    "@obiba/db": "workspace:*",
    "@obiba/domain": "workspace:*",
    "@obiba/intents": "workspace:*",
    "@obiba/near": "workspace:*",
    "@simplewebauthn/server": "13.3.3",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^10.5.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.4",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "rate-limiter-flexible": "11.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "borsh": "2.0.0",
    "jest": "^30.5.2",
    "near-api-js": "7.3.1",
    "supertest": "^7.3.1",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.14",
    "typescript": "5.9.3"
  }
}

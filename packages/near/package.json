{
  "name": "@obiba/near",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "transform": {
      "^.+\\.(ts|tsx|js|mjs)$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "esModuleInterop": true
          },
          "diagnostics": {
            "ignoreCodes": [
              151001
            ]
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/\\.pnpm/(?!(@noble\\+|@scure\\+|near-api-js@))"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "mjs",
      "json"
    ],
    "moduleNameMapper": {
      "^@obiba/(domain|db|near|intents)$": "<rootDir>/../../packages/$1/src"
    }
  },
  "dependencies": {
    "@obiba/domain": "workspace:*",
    "@scure/base": "^1.2.6",
    "borsh": "2.0.0",
    "near-api-js": "7.3.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ]
}

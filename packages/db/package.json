{
  "name": "@obiba/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "migrate": "ts-node src/cli.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testTimeout": 120000,
    "moduleNameMapper": {
      "^@obiba/(domain|db|near|intents)$": "<rootDir>/../../packages/$1/src"
    }
  },
  "dependencies": {
    "@obiba/domain": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.14",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
